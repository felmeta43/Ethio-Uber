<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom navigation icon/text color selector.
    Selected state uses the primary green; unselected uses secondary text grey.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/primary" android:state_checked="true" />
    <item android:color="@color/text_secondary" />
</selector>
