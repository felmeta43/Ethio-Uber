<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment android:id="@+id/loginFragment"
        android:name="com.ethiouber.customer.ui.auth.LoginFragment"
        android:label="Login">
        <action android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/registerFragment"
        android:name="com.ethiouber.customer.ui.auth.RegisterFragment"
        android:label="Register">
        <action android:id="@+id/action_registerFragment_to_otpFragment"
            app:destination="@id/otpFragment" />
    </fragment>

    <fragment android:id="@+id/otpFragment"
        android:name="com.ethiouber.customer.ui.auth.OtpFragment"
        android:label="Verify OTP">
        <action android:id="@+id/action_otpFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/homeFragment"
        android:name="com.ethiouber.customer.ui.home.HomeFragment"
        android:label="Home">
        <action android:id="@+id/action_homeFragment_to_createOrderFragment"
            app:destination="@id/createOrderFragment" />
    </fragment>

    <fragment android:id="@+id/createOrderFragment"
        android:name="com.ethiouber.customer.ui.order.CreateOrderFragment"
        android:label="New Delivery">
        <action android:id="@+id/action_createOrderFragment_to_trackingFragment"
            app:destination="@id/trackingFragment" />
    </fragment>

    <fragment android:id="@+id/orderHistoryFragment"
        android:name="com.ethiouber.customer.ui.order.OrderHistoryFragment"
        android:label="My Orders">
        <action android:id="@+id/action_orderHistoryFragment_to_trackingFragment"
            app:destination="@id/trackingFragment" />
    </fragment>

    <fragment android:id="@+id/trackingFragment"
        android:name="com.ethiouber.customer.ui.order.TrackingFragment"
        android:label="Track Delivery">
        <argument android:name="orderId" app:argType="integer" />
        <argument android:name="deliveryOtp" app:argType="string" android:defaultValue="" />
        <argument android:name="pickupLat" app:argType="float" android:defaultValue="0" />
        <argument android:name="pickupLng" app:argType="float" android:defaultValue="0" />
        <argument android:name="destLat" app:argType="float" android:defaultValue="0" />
        <argument android:name="destLng" app:argType="float" android:defaultValue="0" />
        <action android:id="@+id/action_trackingFragment_to_ratingFragment"
            app:destination="@id/ratingFragment" />
    </fragment>

    <fragment android:id="@+id/ratingFragment"
        android:name="com.ethiouber.customer.ui.order.RatingFragment"
        android:label="Rate Driver">
        <argument android:name="orderId" app:argType="integer" />
    </fragment>

    <fragment android:id="@+id/walletFragment"
        android:name="com.ethiouber.customer.ui.payment.WalletFragment"
        android:label="Wallet" />

    <fragment android:id="@+id/profileFragment"
        android:name="com.ethiouber.customer.ui.profile.ProfileFragment"
        android:label="Profile" />
</navigation>
