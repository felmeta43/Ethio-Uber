<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- ── Auth ─────────────────────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.ethiouber.driver.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_otpFragment"
            app:destination="@id/otpFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.ethiouber.driver.ui.auth.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_registerFragment_to_otpFragment"
            app:destination="@id/otpFragment" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="com.ethiouber.driver.ui.auth.OtpFragment"
        android:label="Verify OTP">
        <action
            android:id="@+id/action_otpFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ── Main ─────────────────────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.ethiouber.driver.ui.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_homeFragment_to_activeOrderFragment"
            app:destination="@id/activeOrderFragment" />
        <action
            android:id="@+id/action_homeFragment_to_earningsFragment"
            app:destination="@id/earningsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_orderHistoryFragment"
            app:destination="@id/orderHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/activeOrderFragment"
        android:name="com.ethiouber.driver.ui.order.ActiveOrderFragment"
        android:label="Active Order">
        <argument
            android:name="orderId"
            app:argType="integer"
            android:defaultValue="-1" />
        <action
            android:id="@+id/action_activeOrderFragment_to_orderHistoryFragment"
            app:destination="@id/orderHistoryFragment"
            app:popUpTo="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderHistoryFragment"
        android:name="com.ethiouber.driver.ui.order.OrderHistoryFragment"
        android:label="My Trips" />

    <fragment
        android:id="@+id/earningsFragment"
        android:name="com.ethiouber.driver.ui.earnings.EarningsFragment"
        android:label="Earnings">
        <action
            android:id="@+id/action_earningsFragment_to_withdrawalFragment"
            app:destination="@id/withdrawalFragment" />
    </fragment>

    <fragment
        android:id="@+id/withdrawalFragment"
        android:name="com.ethiouber.driver.ui.earnings.WithdrawalFragment"
        android:label="Request Withdrawal" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.ethiouber.driver.ui.profile.ProfileFragment"
        android:label="Profile" />

</navigation>
