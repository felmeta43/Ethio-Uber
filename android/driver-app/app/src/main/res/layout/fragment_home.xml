<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Map occupies full screen; card panel sits on top -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- My-location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_margin="16dp"
        android:layout_marginTop="72dp"
        android:src="@android:drawable/ic_menu_mylocation"
        android:contentDescription="My Location"
        app:backgroundTint="@color/surface"
        app:tint="@color/primary"
        app:fabSize="mini" />

    <!-- Top bar: profile photo + name + rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@color/primary"
            android:scaleType="centerCrop"
            android:contentDescription="Profile photo"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOnlineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/you_are_offline"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.0"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★"
                android:textColor="@color/accent"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Order history shortcut -->
        <ImageView
            android:id="@+id/ivOrderHistory"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:tint="@color/white"
            android:contentDescription="Order History"
            android:padding="4dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Bottom status card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardEarnings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/surface"
        android:layout_margin="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Row 1: Toggle + status message -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_online"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/online"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:layout_marginEnd="8dp" />

                <ProgressBar
                    android:id="@+id/progressStatus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Online toggle button (used by HomeFragment code) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOnlineToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/go_online"
                android:textSize="15sp"
                android:padding="12dp"
                app:cornerRadius="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Status message -->
            <TextView
                android:id="@+id/tv_status_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/waiting_for_orders"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp" />

            <!-- Row 2: Earnings + Deliveries -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_earnings"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvTodayEarnings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETB 0.00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <!-- Alias for today's earnings used in fragment layout spec -->
                    <TextView
                        android:id="@+id/tv_today_earnings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETB 0.00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trips_completed"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvTotalDeliveries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 deliveries"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <!-- Alias used in fragment layout spec -->
                    <TextView
                        android:id="@+id/tv_completed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 trips"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
